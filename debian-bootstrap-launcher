#!/usr/bin/env bash

set -Eeuo pipefail

readonly PROGRAM_NAME="debian-bootstrap-launcher"
readonly PROGRAM_VERSION="0.1.0"

DRY_RUN=0
VERBOSE=0
USE_COLOR=1
TARGET_USER=""
SKIP_ENCRYPTION=0

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/colors.sh
source "${SCRIPT_DIR}/lib/colors.sh"

# shellcheck source=lib/logging.sh
source "${SCRIPT_DIR}/lib/logging.sh"

# shellcheck source=lib/checks.sh
source "${SCRIPT_DIR}/lib/checks.sh"

# shellcheck source=lib/users.sh
source "${SCRIPT_DIR}/lib/users.sh"

# shellcheck source=lib/fscrypt.sh
source "${SCRIPT_DIR}/lib/fscrypt.sh"

# shellcheck source=lib/ui.sh
source "${SCRIPT_DIR}/lib/ui.sh"

# shellcheck source=lib/tasks.sh
source "${SCRIPT_DIR}/lib/tasks.sh"

CONFIG_FILE="${SCRIPT_DIR}/launcher.conf"

if [[ -r "${CONFIG_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${CONFIG_FILE}"
else
    log_error "Missing launcher configuration: ${CONFIG_FILE}"
    exit 1
fi

show_help() {
    cat <<EOF
Usage:
  sudo ./${PROGRAM_NAME} [OPTIONS]

Prepare a Debian 13 system for the private DebianBootstrap workflow.

Options:
  --help                  Show this help message
  --version               Show the launcher version
  --dry-run               Report planned actions without making changes
  --verbose               Enable verbose output
  --no-color              Disable colored terminal output
  --target-user USERNAME  Select the permanent user
  --skip-encryption       Skip the fscrypt workflow

Examples:
  sudo ./${PROGRAM_NAME}
  sudo ./${PROGRAM_NAME} --target-user smcenroe
  sudo ./${PROGRAM_NAME} --dry-run --verbose
EOF
}

show_version() {
    printf '%s %s\n' "${PROGRAM_NAME}" "${PROGRAM_VERSION}"
}

parse_args() {
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --version|-V)
                show_version
                exit 0
                ;;
            --dry-run)
                DRY_RUN=1
                shift
                ;;
            --verbose)
                VERBOSE=1
                shift
                ;;
            --no-color)
                USE_COLOR=0
                shift
                ;;
            --target-user)
                if [[ -z "${2:-}" ]]; then
                    printf 'Missing username after --target-user\n' >&2
                    exit 2
                fi

                TARGET_USER="$2"
                shift 2
                ;;
            --skip-encryption)
                SKIP_ENCRYPTION=1
                shift
                ;;
            --)
                shift
                break
                ;;
            *)
                printf 'Unknown option: %s\n\n' "$1" >&2
                show_help >&2
                exit 2
                ;;
        esac
    done
}

run_preflight() {
    log_info "Starting phase: preflight"

    require_root
    check_debian
    check_debian_version
    detect_execution_context
    check_required_commands
    resolve_target_user

    log_success "Preflight phase completed."
}

run_readiness() {
    log_info "Starting phase: readiness"

    detect_target_filesystem
    detect_ext4_encrypt_feature
    detect_fscrypt_packages
    detect_pam_fscrypt
    detect_home_state
    detect_encryption_state
    enforce_consistent_encryption_state
    report_home_state
    determine_encryption_eligibility
    enforce_encryption_readiness
    handle_unavailable_encryption
    print_readiness_summary
    log_success "Readiness phase completed."
}

run_execution() {
    log_info "Starting phase: execution"

    users_tasks_register
    fscrypt_tasks_register

    run_registered_tasks
    print_task_summary

    log_success "Execution phase completed."
}

run_validation() {
    log_info "Starting phase: validation"

    log_success "Validation phase completed."
}

run_completion() {
    log_info "Starting phase: completion"

    if [[ "${DRY_RUN}" -eq 1 ]]; then
        log_info "Dry-run mode: completion screen suppressed."
        return 0
    fi

    if ! home_is_encrypted; then
        log_error "Completion refused: ${TARGET_HOME} is not encrypted."
        return 1
    fi

    if ! pam_fscrypt_check; then
        log_error "Completion refused: PAM fscrypt integration is not configured."
        return 1
    fi

    if ! recovery_protector_check; then
        log_error "Completion refused: recovery protector is missing."
        return 1
    fi

    print_completion_screen
    log_success "Completion phase finished."
}

main() {
    parse_args "$@"
    init_colors
    print_header
    init_logging

    log_info "${PROGRAM_NAME} ${PROGRAM_VERSION} starting."

    run_preflight
    run_readiness
    run_execution
    run_validation
    run_completion

    log_success "${PROGRAM_NAME} completed."
}

main "$@"
